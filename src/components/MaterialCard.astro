---
interface Sample {
  label: string;
  url: string;
}

interface Props {
  code: string;
  title: string;
  description: string;
  samples: Sample[];
  repoUrl: string;
}

const { code, title, description, samples, repoUrl } = Astro.props;
---
<div class="card-lift bg-white dark:bg-slate/40 rounded-md border border-mist dark:border-steel/30 overflow-hidden flex flex-col">
  <div class="bg-navy p-5 border-b-[3px] border-gold">
    <div class="text-[0.7rem] text-gold font-semibold uppercase tracking-widest">{code}</div>
    <div class="font-serif text-base font-semibold text-white mt-1">{title}</div>
  </div>
  <div class="p-5 flex-1">
    <div class="text-sm text-body dark:text-body leading-relaxed mb-4">{description}</div>
    <ul class="list-none p-0 m-0 mb-4">
      {samples.map(sample => (
        <li class="py-2 border-b border-mist dark:border-steel/30 last:border-b-0 flex items-center justify-between text-sm">
          <a href={sample.url} target="_blank" rel="noopener" class="font-medium text-navy dark:text-mist no-underline hover:text-gold transition-colors">{sample.label}</a>
          <span class="text-[0.7rem] text-caption bg-cloud dark:bg-navy/50 px-2 py-0.5 rounded uppercase tracking-wider font-semibold">PDF</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="px-5 pb-5">
    <a href={repoUrl} target="_blank" rel="noopener"
      class="inline-flex items-center gap-1.5 text-xs font-semibold bg-cloud dark:bg-navy/50 text-steel dark:text-mist border border-mist dark:border-steel/30 px-4 py-2 rounded hover:border-gold hover:text-gold transition-all no-underline">
      Full Repo on GitHub
    </a>
  </div>
</div>
