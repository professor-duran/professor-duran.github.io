---
<BaseLayout title="In the Press -- Adam Duran"
  description="Press coverage of Adam Duran's work in engineering education, the DOE Battery Workforce Challenge, the GCxN clean energy accelerator, and Mines Automotive Engineering Program.">

  <div class="pt-28 pb-20 px-8">
    <div class="max-w-[900px] mx-auto">
      <h1 class="font-serif text-4xl font-bold text-navy dark:text-white mb-2">In the Press</h1>
      <hr class="w-12 h-[3px] bg-gold border-none my-4" />
      <p class="text-base mb-12 max-w-[720px]">
        Selected media coverage of my work across engineering education, vehicle technology competitions, the GCxN clean energy accelerator, and clean technology commercialization.
      </p>

      <!-- Featured outlets strip -->
      <div class="bg-cloud dark:bg-slate/40 rounded-md p-6 mb-16">
        <p class="text-xs text-caption uppercase tracking-widest mb-4">As Covered In</p>
        <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-serif text-steel dark:text-mist/80 italic">
          {featuredOutlets.map(o => <span>{o}</span>)}
        </div>
      </div>

      <h2 class="font-serif text-2xl font-bold text-navy dark:text-white mb-6">Mines & Industry Coverage (2023-2026)</h2>
      <div class="mb-16 space-y-1">
        {recent.map(item => (
          <article class="py-4 border-b border-mist dark:border-steel/30">
            <div class="flex flex-wrap gap-3 items-baseline mb-1">
              <span class="text-gold font-semibold text-xs uppercase tracking-wider whitespace-nowrap">{item.date}</span>
              <span class="text-xs text-caption uppercase tracking-wider">{item.outlet}</span>
            </div>
            {item.url ? (
              <a href={item.url} target="_blank" rel="noopener" class="font-serif text-base font-medium text-navy dark:text-white no-underline hover:text-gold transition-colors block">
                {item.headline} &rarr;
              </a>
            ) : (
              <p class="font-serif text-base font-medium text-navy dark:text-white">{item.headline}</p>
            )}
            {item.note && <p class="text-xs text-caption italic mt-1">{item.note}</p>}
          </article>
        ))}
      </div>

      <h2 class="font-serif text-2xl font-bold text-navy dark:text-white mb-6">NREL & GCxN Era (2015-2020)</h2>
      <div class="space-y-1">
        {nrelEra.map(item => (
          <article class="py-4 border-b border-mist dark:border-steel/30">
            <div class="flex flex-wrap gap-3 items-baseline mb-1">
              <span class="text-gold font-semibold text-xs uppercase tracking-wider whitespace-nowrap">{item.date}</span>
              <span class="text-xs text-caption uppercase tracking-wider">{item.outlet}</span>
            </div>
            {item.url ? (
              <a href={item.url} target="_blank" rel="noopener" class="font-serif text-base font-medium text-navy dark:text-white no-underline hover:text-gold transition-colors block">
                {item.headline} &rarr;
              </a>
            ) : (
              <p class="font-serif text-base font-medium text-navy dark:text-white">{item.headline}</p>
            )}
            {item.note && <p class="text-xs text-caption italic mt-1">{item.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
