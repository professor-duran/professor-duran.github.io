---
import BaseLayout from '../layouts/BaseLayout.astro';
import { keenCards, PROFILE_URL, CARD_URL_PREFIX } from '../data/keen-cards';

// Unique tag set for display as a summary band
const tagCounts = new Map<string, number>();
for (const card of keenCards) {
  for (const tag of card.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---
<BaseLayout
  title="Teaching Cards | Adam W. Duran"
  description="15+ KEEN Engineering Unleashed activity cards authored by Adam W. Duran, covering AI-augmented engineering pedagogy, authentic assessment, design process, and the entrepreneurial mindset."
  activePage="teaching-cards"
>
  <section class="max-w-[1100px] mx-auto pt-32 pb-16 px-8">
    <div class="text-gold text-xs font-medium tracking-widest uppercase mb-2">KEEN Engineering Unleashed</div>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-navy dark:text-white leading-tight mb-4">Teaching Cards</h1>
    <hr class="w-12 h-[3px] bg-gold border-none my-4" />
    <p class="max-w-[760px] text-base leading-relaxed mb-4">
      Published activity cards on the <a href={PROFILE_URL} target="_blank" rel="noopener" class="text-gold no-underline hover:underline">KEEN Engineering Unleashed</a> network. Each card is a structured, classroom-ready artifact that other engineering faculty can adopt, adapt, and cite. Topics span AI-augmented engineering pedagogy, authentic assessment, the full design process from problem definition through delivery, and the entrepreneurial mindset in engineering contexts.
    </p>
    <p class="max-w-[760px] text-sm text-caption mb-8">
      Cards are licensed through the KEEN network. Click any card to open it on engineeringunleashed.com.
    </p>

    <!-- Topic summary band -->
    <div class="flex flex-wrap gap-2 mb-12">
      {sortedTags.map(([tag, count]) => (
        <span class="inline-flex items-center text-xs font-medium px-3 py-1 rounded-full border border-mist dark:border-steel/30 text-steel dark:text-mist/80">
          {tag} <span class="ml-1.5 text-caption">({count})</span>
        </span>
      ))}
    </div>

    <!-- Card grid -->
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {keenCards.map(card => (
        <a
          href={`${CARD_URL_PREFIX}${card.id}`}
          target="_blank"
          rel="noopener"
          class="group block bg-cloud dark:bg-slate/40 rounded-md border border-mist dark:border-steel/30 p-6 no-underline transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_20px_-12px_rgba(0,0,0,0.18)] dark:hover:shadow-[0_12px_20px_-12px_rgba(255,255,255,0.08)] motion-reduce:transform-none motion-reduce:transition-none"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-gold uppercase tracking-wider">Card #{card.id}</span>
            <svg class="w-4 h-4 text-caption group-hover:text-gold transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
          <h2 class="font-serif text-lg font-bold text-navy dark:text-white leading-snug mb-2">
            {card.headline}
          </h2>
          {card.subhead && (
            <p class="text-sm text-steel dark:text-mist/80 leading-snug mb-4">{card.subhead}</p>
          )}
          <div class="flex flex-wrap gap-1.5 mt-4">
            {card.tags.map(tag => (
              <span class="inline-block text-[0.65rem] font-medium uppercase tracking-wider px-2 py-0.5 rounded text-gold bg-gold/10">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <div class="mt-14 pt-8 border-t border-mist dark:border-steel/30 max-w-[760px]">
      <p class="text-sm text-steel dark:text-mist/80 leading-relaxed">
        Adam is a <a href="https://engineeringunleashed.com/crescendo" target="_blank" rel="noopener" class="text-gold no-underline hover:underline">KEEN Crescendo</a> member (Spring 2026) and an EMxAI Working Group Leader in the KERN Community Catalysts Cohort 13. To collaborate on new cards, reach out at <a href="mailto:aduran@mines.edu" class="text-gold no-underline hover:underline">aduran@mines.edu</a>.
      </p>
    </div>
  </section>
</BaseLayout>
