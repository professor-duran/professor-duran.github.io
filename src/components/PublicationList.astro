---
import { publications, worksInProgress, pubStats } from '../data/publications';
---
<section id="publications" class="max-w-[1100px] mx-auto py-20 px-8 border-b border-mist dark:border-steel/30">
  <div class="flex justify-between items-baseline flex-wrap gap-4 mb-8">
    <h2 class="font-serif text-3xl font-bold text-navy dark:text-white">Publications</h2>
    <a href="https://scholar.google.com/citations?user=BQ404mAAAAAJ" target="_blank" rel="noopener"
      class="text-sm text-gold font-semibold border border-gold px-4 py-2 rounded hover:bg-gold hover:text-white transition-all no-underline">
      Full Record on Google Scholar &rarr;
    </a>
  </div>
  <hr class="w-12 h-[3px] bg-gold border-none mb-8" />

  <div class="flex gap-8 md:gap-12 mb-10 flex-wrap">
    <div>
      <div class="font-serif text-3xl font-bold text-navy dark:text-white">{pubStats.publications}</div>
      <div class="text-xs text-caption uppercase tracking-widest">Publications</div>
    </div>
    <div>
      <a href="https://scholar.google.com/citations?user=BQ404mAAAAAJ" target="_blank" rel="noopener" class="no-underline">
        <div class="font-serif text-3xl font-bold text-navy dark:text-white">{pubStats.citations}</div>
        <div class="text-xs text-caption uppercase tracking-widest">Citations</div>
      </a>
    </div>
    <div>
      <div class="font-serif text-3xl font-bold text-navy dark:text-white">{pubStats.hIndex}</div>
      <div class="text-xs text-caption uppercase tracking-widest">h-index</div>
    </div>
    <div>
      <div class="font-serif text-3xl font-bold text-navy dark:text-white">{pubStats.i10Index}</div>
      <div class="text-xs text-caption uppercase tracking-widest">i10-index</div>
    </div>
  </div>

  <!-- Works in Progress -->
  {worksInProgress.length > 0 && (
    <div class="mb-8">
      <h3 class="text-xs text-steel dark:text-mist/60 uppercase tracking-widest mb-4">Works in Progress</h3>
      <div>
        {worksInProgress.map(pub => (
          <div class="py-3 border-b border-mist dark:border-steel/30 last:border-b-0 text-sm leading-relaxed">
            <span class="inline-block bg-gold/15 text-gold text-xs font-semibold px-2 py-0.5 rounded mr-2">
              {pub.status === 'in_preparation' ? 'In Preparation' : 'In Press'}
            </span>
            <span set:html={pub.authors.replace(/Duran, A\./g, '<strong>Duran, A.</strong>')} />
            &ldquo;{pub.title}&rdquo;
            {pub.venue && <span class="text-caption italic"> {pub.venue}</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  <h3 class="text-xs text-steel dark:text-mist/60 uppercase tracking-widest mb-4">
    Selected Publications
    <span class="text-caption normal-case tracking-normal ml-2">Showing {publications.length} of 30+</span>
  </h3>
  <div>
    {publications.map(pub => (
      <div class="py-3 border-b border-mist dark:border-steel/30 last:border-b-0 text-sm leading-relaxed">
        <span class="text-gold font-semibold text-xs">{pub.year}</span> &mdash;
        <span set:html={pub.authors.replace(/Duran, A\b\.?/g, '<strong>Duran, A.</strong>')} />
        &ldquo;{pub.title}&rdquo;
        <span class="text-caption italic">{pub.venue}</span>
        {pub.doi && (
          <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener"
            class="text-gold text-xs ml-1 no-underline hover:underline">
            DOI
          </a>
        )}
        {pub.note && (
          <span class="block text-xs text-gold/80 mt-1 italic">{pub.note}</span>
        )}
      </div>
    ))}
  </div>
</section>
