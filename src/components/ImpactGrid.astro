---
// Figures already shown in ImpactBand ($10.5M+, 252, 1st, 1,044) are omitted here.
const stats = [
  { number: '9', label: 'Distinct Mines courses taught, 6 developed or co-developed' },
  { number: '18+', label: 'Independent study students supervised since 2022' },
  { number: '30+', label: 'Peer-reviewed publications and technical reports', link: 'https://scholar.google.com/citations?user=BQ404mAAAAAJ' },
  { number: '30+', label: 'Capstone teams mentored as Client, Advisor, or Technical Advisor' },
];
---
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10">
  {stats.map(stat => (
    <div class="bg-cloud dark:bg-slate/50 rounded-md p-7 border-l-[3px] border-gold transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_20px_-12px_rgba(0,0,0,0.18)] dark:hover:shadow-[0_12px_20px_-12px_rgba(255,255,255,0.08)] motion-reduce:transform-none motion-reduce:transition-none">
      {stat.link ? (
        <a href={stat.link} target="_blank" rel="noopener" class="no-underline">
          <div class="font-serif text-4xl font-bold text-navy dark:text-white leading-none mb-1">{stat.number}</div>
          <div class="text-sm text-steel dark:text-mist/70 leading-snug">{stat.label}</div>
        </a>
      ) : (
        <>
          <div class="font-serif text-4xl font-bold text-navy dark:text-white leading-none mb-1">{stat.number}</div>
          <div class="text-sm text-steel dark:text-mist/70 leading-snug">{stat.label}</div>
        </>
      )}
    </div>
  ))}
</div>
