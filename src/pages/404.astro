---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found - Adam Duran">
  <div class="pt-40 pb-20 px-8 min-h-[60vh] flex items-center justify-center">
    <div class="text-center max-w-[480px]">
      <div class="font-serif text-6xl font-bold text-navy dark:text-white mb-4">404</div>
      <h1 class="font-serif text-2xl font-bold text-navy dark:text-white mb-4">Page Not Found</h1>
      <p class="text-base text-caption mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/"
        class="inline-block bg-gold text-white font-semibold text-sm tracking-wide px-8 py-3 rounded hover:bg-gold-light transition-colors no-underline">
        Back to Home
      </a>
    </div>
  </div>
</BaseLayout>
