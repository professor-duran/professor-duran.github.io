---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function fmt(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
{posts.length > 0 && (
  <section id="essays" class="max-w-[1100px] mx-auto py-20 px-8">
    <div class="flex justify-between items-baseline flex-wrap gap-4 mb-8">
      <h2 class="font-serif text-3xl font-bold text-navy dark:text-white">Recent Essays</h2>
      <a href="/blog" class="text-sm text-gold font-semibold no-underline hover:underline">All essays &rarr;</a>
    </div>
    <hr class="w-12 h-[3px] bg-gold border-none mb-8" />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map(post => (
        <a href={`/blog/${post.id}/`} class="group block bg-cloud dark:bg-slate/40 rounded-md p-6 border border-mist dark:border-steel/30 hover:border-gold dark:hover:border-gold transition-colors no-underline">
          <div class="flex flex-wrap gap-2 mb-3">
            {post.data.tags.slice(0, 2).map(tag => (
              <span class="text-[0.6rem] text-caption bg-white dark:bg-navy/50 px-2 py-0.5 rounded uppercase tracking-wider font-semibold">{tag}</span>
            ))}
          </div>
          <h3 class="font-serif text-base font-semibold text-navy dark:text-white mb-2 group-hover:text-gold transition-colors leading-snug">{post.data.title}</h3>
          <div class="text-xs text-caption mb-3">
            <time>{fmt(post.data.pubDate)}</time>
            {post.data.readingTime && <span> &middot; {post.data.readingTime}</span>}
          </div>
          <p class="text-sm text-body leading-relaxed line-clamp-3">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
)}
