---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function fmt(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---
<BaseLayout title="Essays -- Adam Duran"
  description="Essays on engineering education, program design, vehicle technology competitions, AI in the classroom, and clean energy commercialization.">

  <div class="pt-28 pb-20 px-8">
    <div class="max-w-[900px] mx-auto">
      <h1 class="font-serif text-4xl font-bold text-navy dark:text-white mb-2">Essays</h1>
      <hr class="w-12 h-[3px] bg-gold border-none my-4" />
      <p class="text-base mb-12 max-w-[720px]">
        Working notes on engineering education, program design, vehicle technology, and the practical work of building experiential programs. Written from the field, not the lectern.
      </p>

      <div class="space-y-8">
        {posts.map(post => (
          <article class="border-b border-mist dark:border-steel/30 pb-8">
            <div class="flex flex-wrap gap-2 mb-2">
              {post.data.tags.map(tag => (
                <span class="text-[0.65rem] text-caption bg-cloud dark:bg-slate/50 px-2 py-0.5 rounded uppercase tracking-wider font-semibold">{tag}</span>
              ))}
            </div>
            <h2 class="font-serif text-2xl font-semibold text-navy dark:text-white mb-2">
              <a href={`/blog/${post.id}/`} class="no-underline hover:text-gold transition-colors">{post.data.title}</a>
            </h2>
            <div class="flex flex-wrap gap-3 items-baseline mb-3 text-xs text-caption">
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              {post.data.readingTime && <span>&middot; {post.data.readingTime}</span>}
            </div>
            <p class="text-sm text-body leading-relaxed mb-3">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="text-sm text-gold font-semibold no-underline hover:underline">Read essay &rarr;</a>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <p class="text-base text-caption">No essays published yet.</p>
      )}
    </div>
  </div>
</BaseLayout>
