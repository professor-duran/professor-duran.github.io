---
const stats = [
  { number: '$10.5M+', label: 'Career competitive funding as PI / Proposal Lead' },
  { number: '252', label: 'Declared auto engineering students (built with Prof. Brodsky from zero)' },
  { number: '9', label: 'Distinct Mines courses taught, 6 developed or co-developed' },
  { number: '18+', label: 'Independent study students supervised since 2022' },
];

const scholarlyStats = [
  { number: '30+', label: 'Peer-reviewed publications and technical reports', link: 'https://scholar.google.com/citations?user=BQ404mAAAAAJ' },
  { number: '1,044', label: 'Google Scholar citations (h-index: 17, i10-index: 21)', link: 'https://scholar.google.com/citations?user=BQ404mAAAAAJ' },
  { number: '1st', label: 'Place nationally, DOE Battery Workforce Challenge Year 1 (2023-24)' },
  { number: '30+', label: 'Capstone teams mentored as Client, Advisor, or Technical Advisor' },
];
---
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10">
  {stats.map(stat => (
    <div class="bg-cloud dark:bg-slate/50 rounded-md p-7 border-l-[3px] border-gold transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_20px_-12px_rgba(0,0,0,0.18)] dark:hover:shadow-[0_12px_20px_-12px_rgba(255,255,255,0.08)] motion-reduce:transform-none motion-reduce:transition-none">
      <div class="font-serif text-4xl font-bold text-navy dark:text-white leading-none mb-1">{stat.number}</div>
      <div class="text-sm text-steel dark:text-mist/70 leading-snug">{stat.label}</div>
    </div>
  ))}
</div>

<div class="mt-4">
  <p class="text-xs text-caption uppercase tracking-widest mb-3 mt-8">Scholarly & Student Impact</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {scholarlyStats.map(stat => (
      <div class="bg-cloud dark:bg-slate/50 rounded-md p-7 border-l-[3px] border-steel/30 dark:border-mist/20 transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_20px_-12px_rgba(0,0,0,0.18)] dark:hover:shadow-[0_12px_20px_-12px_rgba(255,255,255,0.08)] motion-reduce:transform-none motion-reduce:transition-none">
        {stat.link ? (
          <a href={stat.link} target="_blank" rel="noopener" class="no-underline">
            <div class="font-serif text-3xl font-bold text-navy dark:text-white leading-none mb-1">{stat.number}</div>
            <div class="text-sm text-steel dark:text-mist/70 leading-snug">{stat.label}</div>
          </a>
        ) : (
          <>
            <div class="font-serif text-3xl font-bold text-navy dark:text-white leading-none mb-1">{stat.number}</div>
            <div class="text-sm text-steel dark:text-mist/70 leading-snug">{stat.label}</div>
          </>
        )}
      </div>
    ))}
  </div>
</div>
