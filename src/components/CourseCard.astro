---
interface Props {
  code: string;
  name: string;
  description: string;
  crossList?: string;
  developed?: boolean;
}

const { code, name, description, crossList, developed } = Astro.props;
---
<div class="bg-white dark:bg-slate/40 rounded-md p-6 border border-mist dark:border-steel/30">
  <div class="flex items-center gap-2 mb-1">
    <span class="text-xs text-gold font-semibold uppercase tracking-widest">{code}</span>
    {crossList && <span class="text-[10px] text-caption">/ {crossList}</span>}
  </div>
  <div class="font-serif text-base font-semibold text-navy dark:text-white mb-2">
    {name}
    {developed && <span class="text-[10px] text-gold align-super ml-1" title="Course developed or co-developed by instructor">*</span>}
  </div>
  <div class="text-sm text-caption leading-relaxed">{description}</div>
</div>
