---
import { publications, worksInProgress, pubStats } from '../data/publications';

// Emit ScholarlyArticle JSON-LD for every published entry that has a DOI.
// Helps AI and search systems attribute these works to Adam correctly.
const author = {
  '@type': 'Person',
  name: 'Adam W. Duran',
  url: 'https://adamwduran.com',
  sameAs: [
    'https://scholar.google.com/citations?user=BQ404mAAAAAJ',
    'https://orcid.org/0000-0002-7776-3896',
  ],
};

const scholarlySchemas = publications
  .filter(p => !!p.doi)
  .map(p => ({
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    headline: p.title.replace(/\.$/, ''),
    datePublished: String(p.year),
    isPartOf: p.venue.replace(/\.$/, ''),
    identifier: {
      '@type': 'PropertyValue',
      propertyID: 'DOI',
      value: p.doi,
    },
    url: `https://doi.org/${p.doi}`,
    author,
  }));
---
{scholarlySchemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<section id="publications" class="max-w-[1100px] mx-auto py-20 px-8 border-b border-mist dark:border-steel/30">
  <div class="flex justify-between items-baseline flex-wrap gap-4 mb-8">
    <h2 class="font-serif text-3xl font-bold text-navy dark:text-white">Publications</h2>
    <a href="https://scholar.google.com/citations?user=BQ404mAAAAAJ" target="_blank" rel="noopener"
      class="text-sm text-gold font-semibold border border-gold px-4 py-2 rounded hover:bg-gold hover:text-white transition-all no-underline">
      Full Record on Google Scholar &rarr;
    </a>
  </div>
  <hr class="w-12 h-[3px] bg-gold border-none mb-8" />

  <p class="max-w-[760px] text-base mb-10">
    My work sits at the intersection of vehicle electrification, advanced battery systems,
    and the workforce and pedagogy questions that determine whether we can train the
    engineers to deploy them. I contribute vehicle-systems and fleet-data expertise to
    multi-institution collaborations on the hard technical problems of the energy
    transition, including two recent papers in <em>ACS Energy Letters</em> (2024, 2025) on
    decarbonizing off-road vehicles. I am now extending that work into
    engineering-education scholarship on experiential program design and faculty workload.
  </p>

  <div class="flex gap-8 md:gap-12 mb-10 flex-wrap" data-pub-stats>
    <div>
      <div class="font-serif text-3xl font-bold text-navy dark:text-white tabular-nums pub-stat" data-target={pubStats.publications}>{pubStats.publications}</div>
      <div class="text-xs text-caption uppercase tracking-widest">Publications</div>
    </div>
    <div>
      <a href="https://scholar.google.com/citations?user=BQ404mAAAAAJ" target="_blank" rel="noopener" class="no-underline">
        <div class="font-serif text-3xl font-bold text-navy dark:text-white tabular-nums pub-stat" data-target={pubStats.citations}>{pubStats.citations}</div>
        <div class="text-xs text-caption uppercase tracking-widest">Citations</div>
      </a>
    </div>
    <div>
      <div class="font-serif text-3xl font-bold text-navy dark:text-white tabular-nums pub-stat" data-target={pubStats.hIndex}>{pubStats.hIndex}</div>
      <div class="text-xs text-caption uppercase tracking-widest">h-index</div>
    </div>
    <div>
      <div class="font-serif text-3xl font-bold text-navy dark:text-white tabular-nums pub-stat" data-target={pubStats.i10Index}>{pubStats.i10Index}</div>
      <div class="text-xs text-caption uppercase tracking-widest">i10-index</div>
    </div>
  </div>

  <script>
    function initPubStats() {
      const root = document.querySelector('[data-pub-stats]');
      if (!root) return;
      const nums = root.querySelectorAll<HTMLElement>('.pub-stat');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      const seen = new WeakSet<Element>();

      function animate(el: HTMLElement, target: number, dur = 1100) {
        const start = performance.now();
        const startVal = 0;
        function step(now: number) {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          const v = Math.round(startVal + (target - startVal) * eased);
          el.textContent = v.toLocaleString('en-US');
          if (t < 1) requestAnimationFrame(step);
          else el.textContent = target.toLocaleString('en-US');
        }
        // Set to 0 right before we start so the count visibly grows.
        el.textContent = '0';
        requestAnimationFrame(step);
      }

      const obs = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !seen.has(entry.target)) {
              seen.add(entry.target);
              const el = entry.target as HTMLElement;
              const target = parseFloat(el.dataset.target ?? '0');
              animate(el, target);
            }
          }
        },
        { threshold: 0.5 }
      );
      nums.forEach((n) => obs.observe(n));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPubStats);
    } else {
      initPubStats();
    }
  </script>

  <!-- Works in Progress -->
  {worksInProgress.length > 0 && (
    <div class="mb-8">
      <h3 class="text-xs text-steel dark:text-mist/60 uppercase tracking-widest mb-4">Works in Progress</h3>
      <div>
        {worksInProgress.map(pub => (
          <div class="py-3 border-b border-mist dark:border-steel/30 last:border-b-0 text-sm leading-relaxed">
            <span class="inline-block bg-gold/15 text-gold text-xs font-semibold px-2 py-0.5 rounded mr-2">
              {pub.status === 'in_preparation' ? 'In Preparation' : 'In Press'}
            </span>
            <span set:html={pub.authors.replace(/Duran, A\./g, '<strong>Duran, A.</strong>')} />
            &ldquo;{pub.title}&rdquo;
            {pub.venue && <span class="text-caption italic"> {pub.venue}</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  <h3 class="text-xs text-steel dark:text-mist/60 uppercase tracking-widest mb-4">
    Selected Publications
    <span class="text-caption normal-case tracking-normal ml-2">Showing {publications.length} of 30+</span>
  </h3>
  <div>
    {publications.map(pub => (
      <div class="py-3 border-b border-mist dark:border-steel/30 last:border-b-0 text-sm leading-relaxed">
        <span class="text-gold font-semibold text-xs">{pub.year}</span> &mdash;
        <span set:html={pub.authors.replace(/Duran, A\b\.?/g, '<strong>Duran, A.</strong>')} />
        &ldquo;{pub.title}&rdquo;
        <span class="text-caption italic">{pub.venue}</span>
        {pub.doi && (
          <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener"
            class="text-gold text-xs ml-1 no-underline hover:underline">
            DOI
          </a>
        )}
        {pub.note && (
          <span class="block text-xs text-gold/80 mt-1 italic">{pub.note}</span>
        )}
      </div>
    ))}
  </div>
</section>
