---
interface Props {
  name: string;
  acronym: string;
  description: string;
}

const { name, acronym, description } = Astro.props;
---
<div class="bg-cloud dark:bg-slate/40 rounded-md p-8 border-t-[3px] border-gold">
  <h3 class="font-serif text-lg font-semibold text-navy dark:text-white mb-3">{acronym}: {name}</h3>
  <p class="text-sm leading-relaxed">{description}</p>
</div>
