---
// Profile links rendered as the pill row under the tagline. Kept as data so the
// shared styling lives in one place rather than being repeated per anchor.
const profileLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/adamduran/' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=BQ404mAAAAAJ' },
  { label: 'GitHub', href: 'https://github.com/professor-duran' },
  { label: 'ORCID', href: 'https://orcid.org/0000-0002-7776-3896' },
];

const profileLinkClass =
  'text-steel dark:text-mist text-sm font-medium border border-steel/30 dark:border-mist/25 ' +
  'px-4 py-2 rounded hover:border-gold hover:text-gold transition-all no-underline';

// The visible headshot is served as WebP (~87 KB vs ~970 KB for the PNG at the
// same 900x900). The PNG is retained in public/images because it remains the
// og:image and JSON-LD image in BaseLayout, where some social scrapers still
// handle WebP poorly.
const headshot = '/images/headshot.webp';
const headshotAlt = 'Adam W. Duran';
---
<div class="hero-bg pt-40 pb-20 px-8 bg-gradient-to-br from-cloud to-white dark:from-navy dark:to-slate relative overflow-hidden">
  <!-- Drifting mesh-gradient blobs (topographic texture lives on body::before, page-wide) -->
  <div class="hero-mesh absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <!-- Existing gold radial bloom (kept for warmth in upper right) -->
  <div class="absolute -top-[40%] -right-[20%] w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(196,145,60,0.12)_0%,transparent_70%)] dark:bg-[radial-gradient(circle,rgba(196,145,60,0.08)_0%,transparent_70%)] pointer-events-none"></div>
  <div class="max-w-[1100px] mx-auto grid md:grid-cols-[1fr_280px] gap-16 items-center relative">
    <div>
      <!-- Mobile headshot -->
      <div class="md:hidden mb-8 flex justify-center">
        <div class="w-[140px] h-[140px] rounded-full overflow-hidden border-[3px] border-gold/30">
          <img
            src={headshot}
            alt={headshotAlt}
            width="140"
            height="140"
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
      <h1 class="font-serif text-navy dark:text-white text-5xl md:text-[2.8rem] font-bold leading-tight mb-2">Adam W. Duran</h1>
      <div class="text-steel dark:text-mist/70 text-sm font-medium tracking-wide mb-2">
        Program Builder &middot; Engineering Researcher &middot; Innovation Leader
      </div>
      <div class="text-gold text-xs font-medium tracking-widest mb-8">
        PE (Colorado, #PE.0061606) &bull; PMP #3726574
      </div>
      <p class="font-serif text-navy dark:text-white text-2xl md:text-[1.9rem] font-normal leading-snug mb-8 max-w-[620px]">
        I build the academic programs industry needs, research the technology and pedagogy
        that shape engineering practice, and secure the partnerships that sustain them both.
      </p>
      <div class="flex gap-4 flex-wrap items-center">
        <a href="mailto:aduran@mines.edu" class="btn-primary no-underline">aduran@mines.edu</a>
        {profileLinks.map(link => (
          <a href={link.href} target="_blank" rel="noopener" class={profileLinkClass}>{link.label}</a>
        ))}
      </div>
    </div>
    <!-- Desktop headshot -->
    <div class="hidden md:block w-[280px] h-[320px] rounded-md overflow-hidden border-[3px] border-gold/30">
      <img
        src={headshot}
        alt={headshotAlt}
        width="280"
        height="320"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</div>

<style>
  /* Drifting mesh-gradient blobs over a 24s loop. Translate amplitude is large enough
     to be perceptible without distracting; combined with scale this makes the blobs
     "breathe" across the hero rather than sit static. */
  .hero-mesh {
    background:
      radial-gradient(ellipse 60vw 45vh at 12% 25%, rgba(74, 94, 117, 0.36) 0%, transparent 60%),
      radial-gradient(ellipse 50vw 35vh at 85% 75%, rgba(196, 145, 60, 0.24) 0%, transparent 60%),
      radial-gradient(ellipse 70vw 50vh at 50% 110%, rgba(45, 58, 74, 0.28) 0%, transparent 60%);
    animation: hero-mesh-drift 24s ease-in-out infinite;
    will-change: transform;
  }
  :global(.dark) .hero-mesh {
    background:
      radial-gradient(ellipse 60vw 45vh at 12% 25%, rgba(74, 94, 117, 0.55) 0%, transparent 55%),
      radial-gradient(ellipse 50vw 35vh at 85% 75%, rgba(196, 145, 60, 0.18) 0%, transparent 55%),
      radial-gradient(ellipse 70vw 50vh at 50% 110%, rgba(232, 236, 241, 0.08) 0%, transparent 55%);
  }
  @keyframes hero-mesh-drift {
    0%   { transform: translate3d(0,    0,   0) scale(1); }
    25%  { transform: translate3d(60px, -30px, 0) scale(1.08); }
    50%  { transform: translate3d(-40px, 20px, 0) scale(0.94); }
    75%  { transform: translate3d(30px,  40px, 0) scale(1.04); }
    100% { transform: translate3d(0,    0,   0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mesh { animation: none; }
  }
</style>
