---
// Magazine-style pull quote callout. Sized to break the reading rhythm of long
// text sections. Use sparingly: at most one per long section.
interface Props {
  quote: string;
  attribution?: string;
  // Optional small label above the quote ("ON TEACHING", "ON IMPACT", etc.)
  kicker?: string;
  // When true, drop the centered max-width wrapper so the quote can sit
  // inside a grid column alongside an image or other content.
  inline?: boolean;
}
const { quote, attribution, kicker, inline = false } = Astro.props;
const wrapClasses = inline ? '' : 'my-12 max-w-[820px] mx-auto';
---
<aside class={wrapClasses}>
  <div class="relative pl-8 md:pl-14">
    <span
      aria-hidden="true"
      class="absolute left-0 top-0 font-serif text-gold/40 leading-none select-none text-7xl md:text-8xl"
    >&ldquo;</span>
    {kicker && (
      <div class="text-[0.65rem] text-gold uppercase tracking-[0.22em] font-semibold mb-3">
        {kicker}
      </div>
    )}
    <blockquote class="font-serif text-xl md:text-2xl leading-snug text-navy dark:text-white italic">
      {quote}
    </blockquote>
    {attribution && (
      <figcaption class="text-xs text-caption mt-4 not-italic uppercase tracking-widest">
        {attribution}
      </figcaption>
    )}
  </div>
</aside>
