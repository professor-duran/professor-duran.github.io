---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;

const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#programs', label: 'Programs' },
  { href: '/#publications', label: 'Publications' },
  { href: '/#teaching', label: 'Teaching' },
  { href: '/teaching-cards', label: 'Cards', page: 'teaching-cards' },
  { href: '/in-the-classroom', label: 'Gallery', page: 'in-the-classroom' },
  { href: '/projects', label: 'Projects', page: 'projects' },
  { href: '/blog', label: 'Essays', page: 'blog' },
  { href: '/speaking', label: 'Speaking', page: 'speaking' },
  { href: '/press', label: 'Press', page: 'press' },
];
---
<!-- Skip to content -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-gold focus:text-white focus:px-4 focus:py-2 focus:rounded">
  Skip to main content
</a>

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/[.97] dark:bg-navy/[.97] backdrop-blur-sm border-b border-gold/20" aria-label="Main navigation">
  <div class="max-w-[1100px] mx-auto px-8 flex items-center justify-between h-[60px]">
    <a href="/" class="font-serif text-navy dark:text-white text-lg font-semibold tracking-wide no-underline">
      Adam W. <span class="text-gold">Duran</span>
    </a>
    <div class="flex items-center gap-6">
      <div class="hidden lg:flex gap-7">
        {navLinks.map(link => (
          <a href={link.href}
            class:list={[
              "text-xs font-medium uppercase tracking-wider hover:text-gold transition-colors no-underline",
              link.page && activePage === link.page ? 'text-gold' : 'text-steel dark:text-mist'
            ]}
            aria-current={link.page && activePage === link.page ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </div>
      <ThemeToggle />
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-steel dark:text-mist hover:text-gold cursor-pointer" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white dark:bg-navy border-t border-gold/20 px-8 py-4 space-y-3">
    {navLinks.map(link => (
      <a href={link.href} class="block text-steel dark:text-mist text-sm font-medium hover:text-gold transition-colors no-underline mobile-nav-link">
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });

  // Close mobile menu when a link is clicked
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Highlight active nav link on scroll (home page only)
  if (window.location.pathname === '/') {
    const sections = document.querySelectorAll('section[id]');
    const desktopLinks = document.querySelectorAll('nav .hidden.lg\\:flex a[href^="/#"]');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          desktopLinks.forEach(link => {
            const href = link.getAttribute('href');
            // Toggle only text-gold; base classes (text-steel dark:text-mist) show through when removed
            link.classList.toggle('text-gold', href === `/#${id}`);
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });

    sections.forEach(section => observer.observe(section));
  }
</script>
