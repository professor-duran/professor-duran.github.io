---
import { news } from '../data/news';
---
<div class="bg-cloud dark:bg-slate/20">
  <section id="news" class="max-w-[1100px] mx-auto py-20 px-8">
    <h2 class="font-serif text-3xl font-bold text-navy dark:text-white">Recent & Upcoming</h2>
    <hr class="w-12 h-[3px] bg-gold border-none my-4" />
    <div class="max-w-[760px]">
      {news.map(item => (
        <div class="flex gap-4 py-3 border-b border-mist dark:border-steel/30 last:border-b-0">
          <span class="text-gold font-semibold text-xs uppercase tracking-wider whitespace-nowrap min-w-[100px] pt-0.5">{item.date}</span>
          <p class="text-sm leading-relaxed" set:html={item.html} />
        </div>
      ))}
    </div>
  </section>
</div>
