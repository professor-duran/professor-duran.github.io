---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  ogImage?: string;
  includePersonSchema?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
  title,
  description = 'Adam W. Duran, PE, PMP -- Engineering Educator & Program Builder at Colorado School of Mines. $10M+ in funded research, 252 students in programs built from scratch, 30+ publications.',
  activePage = 'home',
  ogImage = '/images/headshot.png',
  includePersonSchema = Astro.url.pathname === '/',
} = Astro.props;

const ogImageURL = new URL(ogImage, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Adam W. Duran',
  givenName: 'Adam',
  familyName: 'Duran',
  honorificSuffix: 'PE, PMP',
  jobTitle: 'Assistant Teaching Professor',
  worksFor: {
    '@type': 'CollegeOrUniversity',
    name: 'Colorado School of Mines',
    department: 'Department of Mechanical Engineering',
    url: 'https://www.mines.edu',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '1500 Illinois Street',
      addressLocality: 'Golden',
      addressRegion: 'CO',
      postalCode: '80401',
      addressCountry: 'US',
    },
  },
  email: 'aduran@mines.edu',
  url: 'https://adamwduran.com',
  image: new URL('/images/headshot.png', Astro.site).toString(),
  description: 'Engineering educator, program architect, and engineering education researcher specializing in experiential, industry-connected academic programs at scale.',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Colorado School of Mines',
    url: 'https://www.mines.edu',
  },
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Professional License',
      name: 'Professional Engineer (PE), State of Colorado',
      identifier: 'PE.0061606',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Professional Certification',
      name: 'Project Management Professional (PMP)',
      recognizedBy: { '@type': 'Organization', name: 'Project Management Institute' },
      identifier: '3726574',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Degree',
      name: 'M.S., Engineering and Technology Management, Colorado School of Mines (2016)',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Degree',
      name: 'M.S., Engineering (Mechanical Specialty), Colorado School of Mines (2011)',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Degree',
      name: 'B.S., Engineering (Mechanical Specialty), Colorado School of Mines (2009)',
    },
  ],
  knowsAbout: [
    'Engineering Education',
    'Experiential Learning',
    'Vehicle Dynamics',
    'Aerospace Systems Engineering',
    'Battery Technology',
    'Clean Energy Technology Commercialization',
    'Program Design and Management',
    'Mastery-Based Assessment',
  ],
  sameAs: [
    'https://www.linkedin.com/in/adamduran/',
    'https://scholar.google.com/citations?user=BQ404mAAAAAJ',
    'https://orcid.org/0000-0002-7776-3896',
    'https://www.researchgate.net/profile/Adam-Duran-2',
    'https://github.com/professor-duran',
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Search engine verification -->
  <meta name="google-site-verification" content="WmXatC_8aF3wLcKRmpjl211lymE83fnW5VJSlYRbYgY" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:site_name" content="Adam W. Duran" />

  {includePersonSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Prevent FOUC for dark mode -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body class="text-body dark:text-body bg-white dark:bg-navy leading-relaxed">
  <Nav activePage={activePage} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
