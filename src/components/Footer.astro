---
const year = new Date().getFullYear();
---
<footer class="bg-slate dark:bg-navy py-12 px-8 border-t border-steel/20">
  <div class="max-w-[1100px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Contact -->
      <div>
        <div class="font-serif text-white text-sm font-semibold mb-3">Contact</div>
        <div class="space-y-1.5 text-sm text-mist">
          <p><a href="mailto:aduran@mines.edu" class="text-gold no-underline hover:underline">aduran@mines.edu</a></p>
          <p><a href="https://mechanical.mines.edu" target="_blank" rel="noopener" class="text-mist no-underline hover:text-gold">Department of Mechanical Engineering</a></p>
          <p><a href="https://www.mines.edu" target="_blank" rel="noopener" class="text-gold no-underline hover:underline">Colorado School of Mines</a></p>
          <p>1500 Illinois Street, Golden, CO 80401</p>
        </div>
      </div>

      <!-- Links -->
      <div>
        <div class="font-serif text-white text-sm font-semibold mb-3">Links</div>
        <div class="space-y-1.5 text-sm">
          <p><a href="https://www.linkedin.com/in/adamduran/" target="_blank" rel="noopener" class="text-gold no-underline hover:underline">LinkedIn</a></p>
          <p><a href="https://scholar.google.com/citations?user=BQ404mAAAAAJ" target="_blank" rel="noopener" class="text-gold no-underline hover:underline">Google Scholar</a></p>
          <p><a href="https://github.com/professor-duran" target="_blank" rel="noopener" class="text-gold no-underline hover:underline">GitHub</a></p>
          <p><a href="https://www.researchgate.net/profile/Adam-Duran-2" target="_blank" rel="noopener" class="text-gold no-underline hover:underline">ResearchGate</a></p>
          <p><a href="https://orcid.org/0000-0002-7776-3896" target="_blank" rel="noopener" class="text-gold no-underline hover:underline">ORCID</a></p>
          <p><a href="/now" class="text-gold no-underline hover:underline">What I'm working on now</a></p>
        </div>
      </div>

      <!-- CV -->
      <div>
        <div class="font-serif text-white text-sm font-semibold mb-3">Curriculum Vitae</div>
        <p class="text-sm text-mist mb-3">Full academic CV including publications, grants, service, and credentials.</p>
        <div class="flex flex-wrap gap-2">
          <a href="https://cdn.jsdelivr.net/gh/professor-duran/academic-cv@main/cv.pdf" target="_blank" rel="noopener"
            class="inline-block text-sm text-gold font-semibold border border-gold px-4 py-2 rounded hover:bg-gold hover:text-white transition-all no-underline">
            View
          </a>
          <a href="https://raw.githubusercontent.com/professor-duran/academic-cv/main/cv.pdf" download
            class="inline-block text-sm text-mist font-semibold border border-mist/40 px-4 py-2 rounded hover:border-gold hover:text-gold transition-all no-underline">
            Download
          </a>
        </div>
      </div>
    </div>

    <hr class="border-steel/30 mb-6" />

    <div class="flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-mist/60">
      <p>&copy; {year} Adam W. Duran. All rights reserved.</p>
      <p>
        <a href="https://mechanical.mines.edu" target="_blank" rel="noopener" class="text-mist/60 no-underline hover:text-gold transition-colors">
          Mines ME Department
        </a>
      </p>
    </div>
  </div>
</footer>
