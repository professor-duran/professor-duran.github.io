---
// Purely additive UX: back-to-top button and subtle scroll fade-up on sections.
// All animation is gated on prefers-reduced-motion: users who opt out see no motion
// and content is fully visible from paint. No CLS: elements start at opacity:1
// unless JS runs and is allowed to animate them.
---
<button
  id="backToTop"
  aria-label="Back to top"
  class="fixed bottom-6 right-6 bg-gold text-white p-3 rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 z-50 hover:bg-gold/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2"
>
  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<style is:global>
  /* Subtle fade-up. Only applies when JS adds .scroll-fade on DOM load,
     so non-JS and reduced-motion users see content immediately. */
  @media (prefers-reduced-motion: no-preference) {
    .scroll-fade {
      opacity: 0;
      transform: translateY(48px);
      transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.9, 0.4, 1.05);
      will-change: opacity, transform;
    }
    .scroll-fade.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #backToTop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script is:inline>
  (function () {
    // Back-to-top
    var btn = document.getElementById('backToTop');
    if (btn) {
      var toggle = function () {
        if (window.scrollY > 600) btn.classList.add('is-visible');
        else btn.classList.remove('is-visible');
      };
      window.addEventListener('scroll', toggle, { passive: true });
      toggle();
      btn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    }

    // Scroll fade-up: skip entirely if user prefers reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;

    // Target top-level sections on any page
    var targets = document.querySelectorAll('main section');
    if (!targets.length) return;
    targets.forEach(function (el) { el.classList.add('scroll-fade'); });

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -80px 0px' });

    targets.forEach(function (el) { io.observe(el); });
  })();
</script>
