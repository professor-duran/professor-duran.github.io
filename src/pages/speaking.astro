---
import BaseLayout from '../layouts/BaseLayout.astro';

const topics = [
  {
    title: 'Building Programs from Zero',
    blurb: 'What it takes to launch a program, fund it, and keep it running once the launch energy fades. Drawn from the Mines automotive track (zero to 252 declared students since 2022) and the Shell GameChanger Accelerator at NREL (30 portfolio companies, $1.048B raised).',
    audience: 'Deans, program directors, corporate innovation leads, foundation officers',
  },
  {
    title: 'Lab to Market: What Early-Stage Climate Tech Needs Now',
    blurb: 'Why early-stage climate capital thinned while overall funding held up, and how GCxN, along with other NLR and national lab programs, fills the gap between a research grant and growth capital.',
    audience: 'Climate investors, national lab tech-transfer offices, corporate venture teams',
  },
  {
    title: 'Electrifying Off-Road Equipment',
    blurb: 'What real duty cycles say about electrifying off-road vehicles, drawing on two ACS Energy Letters papers and commercial fleet data from NREL\'s Fleet DNA database.',
    audience: 'OEM and fleet engineers, equipment operators, energy researchers',
  },
  {
    title: 'Entrepreneurial Mindset in Practice',
    blurb: 'Lessons from co-founding Method & Muse Spirits and directing the GCxN accelerator on turning engineering work into ventures. Part case study, part workshop on spotting opportunities and testing value.',
    audience: 'KEEN schools, entrepreneurship programs, student innovators',
  },
  {
    title: 'Designing for Value: A Two-Part Faculty Workshop',
    blurb: 'Built on KEEN Card 6017 (FDVSE and triple-bottom-line value propositions). Part 1 takes faculty through the activity as learners; Part 2 adapts it to their own course and campus. First delivered at the KEEN Crescendo "Accelerating EM" Deep Dive, Milwaukee, September 2026.',
    audience: 'Engineering faculty, faculty developers',
  },
  {
    title: 'Co-Creating with AI in Engineering Education',
    blurb: 'How I use AI as a team member in project courses, where it confidently gets things wrong, and what that changes about assessment. Includes Fail Faster, Build Better, my 2026 Engineering Unleashed Fellowship project.',
    audience: 'Engineering faculty, ed-tech leaders',
  },
  {
    title: 'Mastery at Scale',
    blurb: 'Running mastery-based, project-heavy courses at large enrollment without burning out the instructor. Drawn from redesigns of MEGN 417/527 and MEGN 456.',
    audience: 'Engineering faculty, instructional designers',
  },
  {
    title: 'Industry-Connected Capstone Design',
    blurb: 'How to source, scope, and run capstone projects that sponsors want to repeat, from 30+ teams advised and service on the Mines Capstone Leadership Team.',
    audience: 'Capstone coordinators, industry partnership offices',
  },
];

// Talks and workshops Adam delivered, newest first.
const talks = [
  { date: 'September 2026', venue: 'KEEN Crescendo "Accelerating EM on Your Campus" Deep Dive, Milwaukee, Wisconsin', role: 'Faculty workshop: FDVSE and triple-bottom-line value propositions (KEEN Card 6017)' },
  { date: 'Fall 2025', venue: 'Generative AI and Human Futures Summit, Colorado School of Mines', role: 'Flash talk: "Co-Creating with AI: New Frontiers in Teaching and Design"' },
  { date: '2018', venue: 'SAE World Congress', role: 'Two technical papers presented' },
  { date: '2017', venue: 'DOE Annual Merit Review', role: 'Multi-modal intra-city freight presentation' },
];

// Programs and conferences attended or joined (not talks), newest first.
const programs = [
  { date: 'September 2026', venue: 'KEEN Crescendo Program', role: 'Named member (Spring 2026 cohort)' },
  { date: 'January 2026', venue: 'KEEN National Conference, Oklahoma City, Oklahoma', role: 'Participant and contributor' },
  { date: 'February 2025', venue: 'KERN/KEEN EMxAI Summit', role: 'Participant' },
  { date: 'September 2023', venue: 'AIAA Pathfinder Conference', role: 'ME department representative' },
];

const guestLectures = [
  'MEGN 408: Spacecraft Subsystems (F23)',
  'MEGN 452: Introduction to Space Exploration (F25)',
  'HNRS 110: Leadership by Design (F24)',
  'MEGN 391: Automotive Design (F24, F25)',
  'EBGN 566: Technology Entrepreneurship (F24, guest judge)',
];
---
<BaseLayout title="Speaking & Workshops | Adam Duran"
  description="Adam Duran: speaking topics and workshops on building programs from zero, lab-to-market climate tech, off-road vehicle electrification, AI in engineering education, and the entrepreneurial mindset.">

  <div class="pt-28 pb-20 px-8">
    <div class="max-w-[900px] mx-auto">
      <h1 class="font-serif text-4xl font-bold text-navy dark:text-white mb-2">Speaking & Workshops</h1>
      <hr class="w-12 h-[3px] bg-gold border-none my-4" />
      <p class="text-base mb-12 max-w-[720px]">
        I speak at conferences, faculty workshops, and industry events on building programs from zero, moving climate technology from lab to market, vehicle electrification, and AI in engineering education. If you're organizing an event and one of these topics fits, get in touch.
      </p>

      <h2 class="font-serif text-2xl font-bold text-navy dark:text-white mb-6">Speaking Topics</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-16">
        {topics.map(t => (
          <div class="bg-cloud dark:bg-slate/40 rounded-md p-6 border-l-[3px] border-gold">
            <div class="font-serif text-base font-semibold text-navy dark:text-white mb-2">{t.title}</div>
            <p class="text-sm text-body leading-relaxed mb-3">{t.blurb}</p>
            <p class="text-xs text-caption uppercase tracking-wider"><span class="font-semibold">Audience:</span> {t.audience}</p>
          </div>
        ))}
      </div>

      <h2 class="font-serif text-2xl font-bold text-navy dark:text-white mb-6">Talks & Workshops</h2>
      <div class="mb-16">
        {talks.map(v => (
          <div class="flex gap-4 py-3 border-b border-mist dark:border-steel/30 text-sm leading-relaxed">
            <span class="text-gold font-semibold text-xs uppercase tracking-wider whitespace-nowrap min-w-[140px] pt-0.5">{v.date}</span>
            <div>
              <div class="font-medium text-navy dark:text-white">{v.venue}</div>
              <div class="text-xs text-caption">{v.role}</div>
            </div>
          </div>
        ))}
      </div>

      <h2 class="font-serif text-2xl font-bold text-navy dark:text-white mb-6">Conferences & Programs</h2>
      <div class="mb-16">
        {programs.map(v => (
          <div class="flex gap-4 py-3 border-b border-mist dark:border-steel/30 text-sm leading-relaxed">
            <span class="text-gold font-semibold text-xs uppercase tracking-wider whitespace-nowrap min-w-[140px] pt-0.5">{v.date}</span>
            <div>
              <div class="font-medium text-navy dark:text-white">{v.venue}</div>
              <div class="text-xs text-caption">{v.role}</div>
            </div>
          </div>
        ))}
      </div>

      <h2 class="font-serif text-2xl font-bold text-navy dark:text-white mb-6">Guest Lectures (Mines)</h2>
      <ul class="list-none p-0 m-0 mb-16 grid grid-cols-1 sm:grid-cols-2 gap-2">
        {guestLectures.map(g => (
          <li class="text-sm py-2 px-3 bg-cloud dark:bg-slate/40 rounded">{g}</li>
        ))}
      </ul>

      <div class="bg-navy text-center rounded-md p-10">
        <h2 class="font-serif text-2xl font-bold text-white mb-3">Inquire About Speaking</h2>
        <p class="text-mist text-base mb-6 max-w-[560px] mx-auto">
          For conference invitations, faculty workshops, or industry events, please include the date, audience, format (keynote, panel, workshop), and which topic interests you.
        </p>
        <a href="mailto:aduran@mines.edu?subject=Speaking%20Inquiry%20-%20%5BEvent%20Name%5D"
          class="inline-block bg-gold text-white font-semibold text-sm tracking-wide px-8 py-3 rounded hover:bg-gold-light transition-colors no-underline">
          Send a Speaking Inquiry
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
